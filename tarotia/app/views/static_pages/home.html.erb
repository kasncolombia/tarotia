<div class="p-4 md:p-8 space-y-6  md:space-y-8">
  <!-- HEADER -->
  <header class="flex items-center justify-between">
    <div class="relative w-full max-w-xl">
      <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </span>
      <input type="text" placeholder="Buscar cartas, lecturas, artículos..." class="w-full bg-white/5 border border-white/10 rounded-2xl py-3 pl-12 pr-4 text-sm focus:outline-none focus:border-mystic-violet/50 focus:ring-4 focus:ring-mystic-violet/10 transition-all">
      <div class="absolute right-4 top-1/2 -translate-y-1/2 flex items-center gap-1 text-[10px] text-zinc-500 bg-white/5 px-1.5 py-1 rounded border border-white/10">
        <span>⌘</span><span>K</span>
      </div>
    </div>
    
    <div class="flex items-center gap-6">
      <button class="relative text-zinc-400 hover:text-white transition-colors hidden md:block">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <span class="absolute top-0 right-0 w-2 h-2 bg-rose-500 rounded-full"></span>
      </button>
      <% if logged_in? %>
        <div class="flex items-center gap-3">
          <div class="text-right hidden md:block">
            <p class="text-sm font-bold text-white leading-none">Alexandra</p>
            <span class="text-[10px] text-mystic-gold font-bold uppercase">PRO</span>
          </div>
          <div class="w-10 h-10 rounded-full border-2 border-mystic-violet/30 p-0.5">
            <img src="https://ui-avatars.com/api/?name=Alexandra&background=7C3AED&color=fff" class="w-full h-full rounded-full object-cover">
          </div>
        </div>
      <% else %>
        <div class="flex items-center gap-3">
          <a href="<%= login_path %>" class="px-4 py-2 bg-primary-container text-on-primary-container text-sm font-bold rounded-lg hover:brightness-110 transition-all">Iniciar Sesión</a>
          <a href="<%= registro_path %>" class="px-4 py-2 bg-white/10 backdrop-blur-md text-white text-sm font-bold rounded-lg border border-white/10 hover:bg-white/20 transition-all">Registrarse</a>
        </div>
      <% end %>
    </div>
  </header>


  


  <!-- HERO SECTION -->
  <section class="relative rounded-3xl overflow-hidden border border-white/5 bg-surface-dark">
    <div class="grid grid-cols-1 md:grid-cols-2 min-h-[300px] md:min-h-[340px]">
      <div class="relative flex flex-col justify-center px-8 md:px-12 py-10 md:py-16 z-10">
        <span class="text-mystic-violet font-bold text-sm mb-2 tracking-wide text-white uppercase"><%= logged_in? ? 'Bienvenida de nuevo' : 'Bienvenida' %>, <%= logged_in? ? current_user[:name] : 'Viajerx' %> 🌙</span>
         <h2 class="text-5xl font-bold max-w-2xl leading-tight mb-6 text-white">
        Descubre tu destino con el poder del <span class="bg-gradient-to-r from-mystic-violet to-cyan-400 bg-clip-text text-transparent">Tarot IA</span>
      </h2>
        <p class="text-zinc-300 max-w-lg mb-8 leading-relaxed">
        Conecta con tu intuición y recibe guía personalizada a través de lecturas inteligentes generadas por IA.
      </p>
        <div class="flex gap-4">
        <button class="px-8 py-3 bg-mystic-violet text-white font-bold rounded-2xl shadow-xl shadow-mystic-violet/30 hover:scale-105 active:scale-95 transition-all">Nueva Lectura</button>
        <button class="px-8 py-3 bg-white/10 backdrop-blur-md text-white font-bold rounded-2xl border border-white/10 hover:bg-white/20 transition-all">Tirada del Día</button>
      </div>
      </div>

      <div class="relative min-h-[200px] md:min-h-full">
        <img src="/portada-hero-tarot.png" alt="Tarot IA" class="absolute inset-0 w-full h-full object-cover object-right" />
        <div class="absolute inset-0 bg-gradient-to-r from-surface-dark via-surface-dark/60 to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- GRID DE TIPOS DE LECTURA -->
  <!-- GRID DE TIPOS DE LECTURA -->
  <section class="grid grid-cols-5 gap-4">
    <% [
      {title: 'Lectura Rápida', sub: '1 carta', icon: 'M13 10V3L4 14h7v7l9-11h-7z', desc: 'Respuesta inmediata'},
      {title: 'P, P, Futuro', sub: '3 cartas', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', desc: 'Claridad y perspectiva'},
      {title: 'Cruz Celta', sub: '10 cartas', icon: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z', desc: 'Análisis profundo'},
      {title: 'Amor', sub: 'Conexiones', icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z', desc: 'Relaciones y emociones', color: 'text-rose-400', bg: 'bg-rose-400/10'},
      {title: 'Dinero', sub: 'Finanzas', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z', desc: 'Abundancia y trabajo', color: 'text-emerald-400', bg: 'bg-emerald-400/10'}
    ].each do |reading| %>
      <div class="bg-[#1A1525] border border-white/5 rounded-3xl p-6 text-center hover:border-mystic-violet/30 hover:bg-mystic-violet/5 hover:-translate-y-1 transition-all group cursor-pointer">
        <div class="w-12 h-12 <%= reading[:bg] || 'bg-mystic-violet/10' %> rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 <%= reading[:color] || 'text-mystic-violet' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= reading[:icon] %>"/></svg>
        </div>
        <h3 class="text-sm font-bold mb-1 text-white"><%= reading[:title] %></h3>
        <p class="text-[10px] text-zinc-500 font-bold uppercase mb-2 tracking-tighter"><%= reading[:sub] %></p>
        <p class="text-[11px] text-zinc-400 leading-tight"><%= reading[:desc] %></p>
      </div>
    <% end %>
  </section>

  <!-- ÚLTIMA LECTURA Y RECOMENDADOS -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8">
    <!-- Tu última lectura -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-bold text-on-surface">Tu última lectura</h3>
        <a href="#" class="text-xs text-primary font-bold hover:underline">Ver todas &gt;</a>
      </div>
      <div class="bg-surface-dark/50 border border-white/5 rounded-2xl p-6 md:p-8">
        <div class="flex items-center gap-4 mb-6">
          <span class="bg-primary/20 text-primary text-[11px] font-bold px-3 py-1 rounded-lg">Pasado, Presente, Futuro</span>
          <span class="text-[11px] text-on-surface-variant">18 Mayo 2024</span>
        </div>
        <h4 class="text-xl md:text-2xl font-bold text-on-surface mb-6 italic">¿Qué viene para mí en el amor?</h4>
        <div class="grid grid-cols-3 gap-3 md:gap-4 mb-6">
          <% [
            {label: 'Pasado', name: 'La Emperatriz', img: '/emperatriz-tarot.png', meaning: 'Abundancia, crecimiento'},
            {label: 'Presente', name: 'Los Enamorados', img: '/los-enamordos.png', meaning: 'Decisión importante'},
            {label: 'Futuro', name: 'El Mundo', img: '/el-mundo.png', meaning: 'Cierre de ciclo, éxito'}
          ].each do |card| %>
            <div>
              <p class="text-[10px] text-on-surface-variant uppercase tracking-tighter mb-2 text-center"><%= card[:label] %></p>
              <div class="relative aspect-[2/3] rounded-xl overflow-hidden border border-primary/20 bg-surface-dark cursor-pointer hover:border-primary/50 hover:shadow-lg hover:shadow-primary/10 transition-all duration-300 mb-2">
                <img src="<%= card[:img] %>" alt="<%= card[:name] %>" class="absolute inset-0 w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-dark/90 via-surface-dark/20 to-transparent"></div>
              </div>
              <p class="text-[11px] font-bold text-on-surface text-center"><%= card[:name] %></p>
              <p class="text-[9px] text-on-surface-variant text-center leading-tight"><%= card[:meaning] %></p>
            </div>
          <% end %>
        </div>
        <button class="w-full py-3 bg-white/5 border border-white/10 text-on-surface text-xs font-bold rounded-xl hover:bg-white/10 transition-all">Ver interpretación completa</button>
      </div>
    </div>

    <!-- Recomendado para ti -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-bold text-on-surface">Recomendado <span class="text-primary">✨</span></h3>
        <a href="#" class="text-xs text-primary font-bold hover:underline">Ver más &gt;</a>
      </div>
      <div class="space-y-4">
        <% [
          {title: 'Guía completa: Significado de cada carta del Tarot', cat: 'Guía', catColor: 'bg-primary/10 text-primary'},
          {title: '¿Cómo hacer una tirada de Tarot para el amor?', cat: 'Amor', catColor: 'bg-rose-passion/10 text-rose-passion'},
          {title: 'El Tarot y los signos del zodiaco: descubre tu carta', cat: 'Astrología', catColor: 'bg-cyan-ethereal/10 text-cyan-ethereal'}
        ].each do |post| %>
          <div class="flex gap-4 p-4 bg-white/5 rounded-2xl hover:bg-white/10 transition-all cursor-pointer">
            <div class="w-16 h-16 bg-surface-dark rounded-xl shrink-0"></div>
            <div class="flex-1 min-w-0">
              <h4 class="text-sm font-bold text-on-surface line-clamp-2"><%= post[:title] %></h4>
              <span class="text-[10px] <%= post[:catColor] %> font-bold px-1.5 py-0.5 rounded mt-2 inline-block"><%= post[:cat] %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>