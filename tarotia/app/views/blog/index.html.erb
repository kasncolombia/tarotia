<div class="space-y-gutter pb-24">
  <!-- Header & Search -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
    <div>
      <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface font-bold mb-2">Blog &amp; Guías</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">Explora los misterios del tarot, aprende nuevas tiradas y descubre cómo la inteligencia artificial está transformando la adivinación.</p>
    </div>
    <div class="w-full md:w-80 glass-input rounded-lg flex items-center px-4 py-3 transition-all">
      <span class="material-symbols-outlined text-outline mr-3">search</span>
      <input class="bg-transparent border-none text-on-surface font-body-md text-body-md w-full focus:outline-none focus:ring-0 placeholder-outline-variant" placeholder="Buscar artículos, guías..." type="text"/>
    </div>
  </div>

  <!-- Hero Featured Article -->
  <article class="glass-card rounded-xl overflow-hidden relative min-h-[400px] md:min-h-[500px] flex flex-col justify-end group cursor-pointer" onclick="window.location='<%= blog_post_path(1) %>'">
    <img alt="Featured mystical artwork" class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCvkPn6jfojdvKN8fLJuc2Nvt2Y-tdydTcKs27YczRGqM-cYN6TRlbCqxTD9b8uvUUTP_JRwGyHhwW0SbMRTMyFamLTyRGvApJED7Ixg80Ofrd2q2gcP4oY8X2mMZ3--03ufWXETrGmeOBmq3aztJgD-wDqw35eNlKUslHm-qK0cAi3sUubL2olLDqIRtrQfQX-kF3aOvISAcNg6gIUsh6s5BjSflrEabUmvU0fYkPNX4F-Y3im7uJJnNdwlVbs6auLWCnRusGjKho_"/>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0F0A1A] via-[#0F0A1A]/80 to-transparent z-10"></div>
    <div class="relative z-20 p-6 md:p-10 w-full md:w-3/4 lg:w-2/3">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-label-mono text-label-mono bg-primary-container/20 text-primary border border-primary/30 px-2 py-1 rounded-full uppercase tracking-wider backdrop-blur-sm">Destacado</span>
        <span class="font-label-mono text-label-mono bg-cyan-ethereal/20 text-cyan-ethereal border border-cyan-ethereal/30 px-2 py-1 rounded-full uppercase tracking-wider backdrop-blur-sm">Tecnología</span>
      </div>
      <h2 class="font-headline-md text-headline-md md:text-[40px] md:leading-tight text-white font-bold mb-4 group-hover:text-primary transition-colors duration-300">La Evolución del Tarot en la Era de la Inteligencia Artificial</h2>
      <p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-2 md:line-clamp-3">Descubre cómo los algoritmos de aprendizaje profundo están reinterpretando los antiguos arquetipos, ofreciendo lecturas con una precisión estadística que desafía la intuición tradicional sin perder la magia.</p>
      <div class="flex items-center gap-4 text-on-surface-variant font-label-mono text-label-mono">
        <div class="flex items-center gap-2">
          <img alt="Author avatar" class="w-6 h-6 rounded-full object-cover" src="https://ui-avatars.com/api/?name=Elion+V&background=7C3AED&color=fff"/>
          <span>Por Elion V.</span>
        </div>
        <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
        <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">schedule</span> 8 min lectura</span>
      </div>
    </div>
  </article>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter pt-8">
    <!-- Articles Grid -->
    <div class="lg:col-span-8 space-y-8">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Últimas Publicaciones</h3>
        <button class="font-label-mono text-label-mono text-primary hover:text-primary-fixed flex items-center gap-1 transition-colors">Ver todas <span class="material-symbols-outlined text-[16px]">arrow_forward</span></button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% [
          {t: 'Guía para principiantes: Tu primera lectura', c: 'Fundamentos', cat_color: 'emerald-abundance', i: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCfDpMTToJB9zA-sYE9iwhSmVO_YYfYPiwRRLTOv32SzfxdGwZ-2zNjn1r2xYN9-POScBUV50RgCrmFqzzuOmMYERTf8HeXNG2qaHAJy7S2RwL1sbDpZRnkvujLrr2690NAy6oB7s5wRUdGzHaWWW6tlfNVmHD1KdxVE_KDgjrwqP0Yt9f4sGoer48L7F7LRC4mYLnWlnnveeTCNgCt9XxQFJiKLvCtlTqFRV5uie5xpIFhBxzhwSKgivcXX1Gq7dCphYLlt0p_CbE6', d: 'Hace 2 días', time: '5 min'},
          {t: 'Significado Profundo de los Arcanos Mayores', c: 'Arcanos', cat_color: 'gold-mystic', i: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDigD6hnepBcmkrIKrDKRIxZuYSBQN8isiWuNGZl8ys0zPjxZHuVKEuEZZ_bmXBpafA2XFxhrQzvevjIy9xhI9Bdan_vkPIn18xEvxgmsgPQBZb9vVlOVaZ8ont76q2ubViNqN_AyYaRXVUo9wAuzUObiL1IyQOHAnWhpLFKdjWNd8K2WuquDcne2jhgGO6i9X1UCKbQmkyOTqekkQL0sPA_S0cNoHk7r2V-mWGxrKs910AgYdqMLqwjoh6pu0F6W2DQgIMG0XY3wbl', d: 'Hace 5 días', time: '12 min'},
          {t: 'Cómo entrenar tu propio oráculo digital', c: 'Tecnología', cat_color: 'cyan-ethereal', i: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAvPJH0bcVywmmC35qsrGR5bGW26B_PkAp9iWWCHGpZNdHKmSCGrAI54qJ6ZAjgGKhkwFJ4f8TI8VNx3ME7Uw94ZBrhnZzdY-cRicIkD-XXCyKwXYSPzLCJvlre97uq9J1RaPE1qzZ40BrDFsnimUNXz-A2-qPn66YfZi9A76TPk-X_Mso6cweEPAoQ3JBMPBdojjDvZiZYvVKJpPGRKYTvCogFJXTdjwbL7bYhv8hkK4dR6dzeSyD4-_1R7tQSQMfQV3A1vpZ11BEE', d: 'Hace 1 semana', time: '6 min'},
          {t: 'Rituales de Limpieza para tu Espacio Digital', c: 'Prácticas', cat_color: 'mystic-violet-400', i: 'https://lh3.googleusercontent.com/aida-public/AB6AXuD1gHo04angeBB6DFlxjCN8cyvUQgp9-KLuUg0sh95EewNFodBiRi4vde9vgpm6m0MrMy3HsiDL4ABbV3ivu3L9AG0vJ0GlTPGNhb4D5L5WEie66Gy5SCo-WFmI__r-Y87D_Q9KFyykiinBXGodm76ARaTqj9uTS4J0lzK-ku1KNt-EzdS9Mxeb37RsxhqRbyAmhgwgpoaA77dTbgjz7ncTRlvwi0B8r90k7IfFriEQQeAjwCPstn7SOhYHwX3lr1nklYQrAgoH3A_U', d: 'Hace 2 semanas', time: '4 min'}
        ].each do |post| %>
          <article class="glass-card rounded-xl overflow-hidden flex flex-col group cursor-pointer">
            <div class="h-48 overflow-hidden relative">
              <img alt="Post thumbnail" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src="<%= post[:i] %>"/>
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <div class="mb-3">
                <span class="font-label-mono text-label-mono bg-<%= post[:cat_color] %>/20 text-<%= post[:cat_color] %> border border-<%= post[:cat_color] %>/30 px-2 py-1 rounded-full uppercase tracking-wider"><%= post[:c] %></span>
              </div>
              <h4 class="font-headline-sm text-headline-sm text-on-surface font-semibold mb-2 group-hover:text-primary transition-colors line-clamp-2"><%= post[:t] %></h4>
              <p class="font-body-sm text-body-sm text-on-surface-variant mb-4 line-clamp-2 flex-1">Descubre los secretos mejor guardados y potencia tu conexión con el universo a través de nuestras guías expertas.</p>
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                <span class="font-label-mono text-label-mono text-outline"><%= post[:d] %></span>
                <span class="font-label-mono text-label-mono text-primary flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">menu_book</span> <%= post[:time] %></span>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </div>

    <!-- Sidebar (Right Column) -->
    <aside class="lg:col-span-4 space-y-8">
      <!-- Populares Widget -->
      <div class="glass-card rounded-xl p-6">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold border-b border-white/10 pb-4 mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-gold-mystic">local_fire_department</span>
          Populares
        </h3>
        <div class="space-y-6">
          <% [
            {n: '01', t: 'La Tirada de la Cruz Celta Explicada Paso a Paso'},
            {n: '02', t: 'El Loco: Riesgo vs. Estupidez en las decisiones modernas'},
            {n: '03', t: 'Cómo interpretar cartas invertidas sin miedo'},
            {n: '04', t: 'Amor y Relaciones: Tirada de las 3 Lunas'}
          ].each do |pop| %>
            <a class="flex gap-4 group" href="#">
              <span class="font-display-lg text-[40px] text-surface-variant group-hover:text-primary-container transition-colors leading-none font-bold"><%= pop[:n] %></span>
              <div>
                <h4 class="font-body-md text-body-md text-on-surface font-semibold group-hover:text-primary transition-colors line-clamp-2 mb-1"><%= pop[:t] %></h4>
                <span class="font-label-mono text-label-mono text-outline">15 min lectura</span>
              </div>
            </a>
          <% end %>
        </div>
      </div>

      <!-- Categories Widget -->
      <div class="glass-card rounded-xl p-6">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold border-b border-white/10 pb-4 mb-4">Categorías</h3>
        <div class="flex flex-wrap gap-2">
          <% ['Arcanos Mayores', 'IA & Tecnología', 'Tiradas Populares', 'Astrología', 'Fundamentos', 'Meditación'].each do |cat| %>
            <a class="font-label-mono text-label-mono px-3 py-1.5 rounded-full border border-white/10 text-on-surface-variant hover:bg-white/5 hover:text-white transition-colors" href="#"><%= cat %></a>
          <% end %>
        </div>
      </div>

      <!-- PRO Promo Widget -->
      <div class="rounded-xl p-1 relative overflow-hidden group cursor-pointer">
        <div class="absolute inset-0 bg-gradient-to-br from-gold-mystic to-primary opacity-50 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="bg-surface-container-high relative z-10 h-full rounded-lg p-6 flex flex-col items-center text-center">
          <span class="material-symbols-outlined text-[48px] text-gold-mystic mb-4">workspace_premium</span>
          <h4 class="font-headline-sm text-headline-sm text-on-surface font-bold mb-2">Desbloquea el Oráculo PRO</h4>
          <p class="font-body-sm text-body-sm text-on-surface-variant mb-6">Accede a guías exclusivas, tiradas avanzadas y lecturas de IA sin límite. Eleva tu práctica espiritual.</p>
          <button class="w-full bg-gold-mystic text-on-tertiary-fixed font-body-md text-body-md font-bold py-3 rounded-lg shadow-lg hover:shadow-xl transition-all">Conocer más</button>
        </div>
      </div>
    </aside>
  </div>
</div>