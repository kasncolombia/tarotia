<div class="space-y-gutter pb-24">
  <!-- Header & Search -->
  <div class="relative pt-8 pb-8">
    <div class="absolute top-0 left-0 w-32 h-32 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="font-label-mono text-label-mono text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20 uppercase tracking-wider mb-4 inline-block">Blog y Conocimiento</span>
        <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface font-bold mb-2">Blog &amp; Guías</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">Explora los misterios del tarot, aprende nuevas tiradas y descubre cómo la inteligencia artificial está transformando la adivinación.</p>
      </div>
      <div class="w-full md:w-80 glass-input rounded-lg flex items-center px-4 py-3 transition-all">
        <span class="material-symbols-outlined text-primary mr-3">search</span>
        <input class="bg-transparent border-none text-on-surface font-body-md text-body-md w-full focus:outline-none focus:ring-0 placeholder-outline-variant" placeholder="Buscar artículos, guías..." type="text"/>
      </div>
    </div>
    <div class="h-px bg-gradient-to-r from-primary/40 via-transparent to-transparent mt-8"></div>
  </div>

  <!-- Hero Featured Article -->
  <% if @featured_post %>
    <article class="glass-card rounded-xl overflow-hidden relative min-h-[400px] md:min-h-[500px] flex flex-col justify-end group cursor-pointer" onclick="window.location='<%= blog_post_path(@featured_post) %>'">
      <img alt="<%= @featured_post.title %>" class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-700 group-hover:scale-105" src="<%= @featured_post.cover_image %>"/>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0F0A1A] via-[#0F0A1A]/80 to-transparent z-10"></div>
      <div class="relative z-20 p-6 md:p-10 w-full md:w-3/4 lg:w-2/3">
        <div class="flex items-center gap-3 mb-4">
          <span class="font-label-mono text-label-mono bg-primary-container/20 text-primary border border-primary/30 px-2 py-1 rounded-full uppercase tracking-wider backdrop-blur-sm">Destacado</span>
          <span class="font-label-mono text-label-mono bg-<%= @featured_post.category_color %>/20 text-<%= @featured_post.category_color %> border border-<%= @featured_post.category_color %>/30 px-2 py-1 rounded-full uppercase tracking-wider backdrop-blur-sm"><%= @featured_post.category %></span>
        </div>
        <h2 class="font-headline-md text-headline-md md:text-[40px] md:leading-tight text-white font-bold mb-4 group-hover:text-primary transition-colors duration-300"><%= @featured_post.title %></h2>
        <p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-2 md:line-clamp-3"><%= @featured_post.excerpt %></p>
        <div class="flex items-center gap-4 text-on-surface-variant font-label-mono text-label-mono">
          <div class="flex items-center gap-2">
            <img alt="Author avatar" class="w-6 h-6 rounded-full object-cover" src="https://ui-avatars.com/api/?name=<%= u(@featured_post.author.gsub('Por ', '')) %>&background=7C3AED&color=fff"/>
            <span><%= @featured_post.author %></span>
          </div>
          <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
          <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">schedule</span> <%= @featured_post.reading_time %> lectura</span>
        </div>
      </div>
    </article>
  <% end %>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter pt-8">
    <!-- Articles Grid -->
    <div class="lg:col-span-8 space-y-8">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Últimas Publicaciones</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% @posts.each do |post| %>
          <article class="glass-card rounded-xl overflow-hidden flex flex-col group cursor-pointer" onclick="window.location='<%= blog_post_path(post) %>'">
            <div class="h-48 overflow-hidden relative">
              <img alt="<%= post.title %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src="<%= post.cover_image %>"/>
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <div class="mb-3">
                <span class="font-label-mono text-label-mono bg-<%= post.category_color %>/20 text-<%= post.category_color %> border border-<%= post.category_color %>/30 px-2 py-1 rounded-full uppercase tracking-wider"><%= post.category %></span>
              </div>
              <h4 class="font-headline-sm text-headline-sm text-on-surface font-semibold mb-2 group-hover:text-primary transition-colors line-clamp-2"><%= post.title %></h4>
              <p class="font-body-sm text-body-sm text-on-surface-variant mb-4 line-clamp-2 flex-1"><%= post.excerpt %></p>
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                <span class="font-label-mono text-label-mono text-outline"><%= time_ago_in_words(post.published_at) %></span>
                <span class="font-label-mono text-label-mono text-primary flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">menu_book</span> <%= post.reading_time %></span>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="lg:col-span-4 space-y-8">
      <div class="glass-card rounded-xl p-6">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold border-b border-white/10 pb-4 mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-gold-mystic">local_fire_department</span>
          Populares
        </h3>
        <div class="space-y-6">
          <% @posts.limit(4).each_with_index do |post, i| %>
            <a class="flex gap-4 group" href="<%= blog_post_path(post) %>">
              <span class="font-display-lg text-[40px] text-surface-variant group-hover:text-primary-container transition-colors leading-none font-bold"><%= format('%02d', i + 1) %></span>
              <div>
                <h4 class="font-body-md text-body-md text-on-surface font-semibold group-hover:text-primary transition-colors line-clamp-2 mb-1"><%= post.title %></h4>
                <span class="font-label-mono text-label-mono text-outline"><%= post.reading_time %> lectura</span>
              </div>
            </a>
          <% end %>
        </div>
      </div>

      <div class="glass-card rounded-xl p-6">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold border-b border-white/10 pb-4 mb-4">Categorías</h3>
        <div class="flex flex-wrap gap-2">
          <% @posts.pluck(:category).uniq.each do |cat| %>
            <a class="font-label-mono text-label-mono px-3 py-1.5 rounded-full border border-white/10 text-on-surface-variant hover:bg-white/5 hover:text-white transition-colors" href="#"><%= cat %></a>
          <% end %>
        </div>
      </div>

      <div class="rounded-xl p-1 relative overflow-hidden group cursor-pointer">
        <div class="absolute inset-0 bg-gradient-to-br from-gold-mystic to-primary opacity-50 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="bg-surface-container-high relative z-10 h-full rounded-lg p-6 flex flex-col items-center text-center">
          <span class="material-symbols-outlined text-[48px] text-gold-mystic mb-4">workspace_premium</span>
          <h4 class="font-headline-sm text-headline-sm text-on-surface font-bold mb-2">Desbloquea el Oráculo PRO</h4>
          <p class="font-body-sm text-body-sm text-on-surface-variant mb-6">Accede a guías exclusivas, tiradas avanzadas y lecturas de IA sin límite. Eleva tu práctica espiritual.</p>
          <button class="w-full bg-gold-mystic text-on-tertiary-fixed font-body-md text-body-md font-bold py-3 rounded-lg shadow-lg hover:shadow-xl transition-all">Conocer más</button>
        </div>
      </div>
    </aside>
  </div>
</div>