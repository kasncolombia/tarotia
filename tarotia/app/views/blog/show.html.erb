<!-- Reading Progress Bar -->
<div class="sticky top-0 w-full h-[3px] z-40 bg-surface-container-highest">
  <div class="h-full bg-primary" style="width: 35%;"></div>
</div>

<!-- Back navigation -->
<nav class="mb-6">
  <a href="<%= blog_path %>" class="text-primary hover:text-primary-fixed flex items-center gap-2 transition-colors font-body-md text-body-md">
    <span class="material-symbols-outlined text-[20px]">arrow_back</span>
    Volver al Blog
  </a>
</nav>

<!-- Main Layout Container -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
  <!-- Article Content Area -->
  <article class="lg:col-span-8">
    <!-- Hero Image -->
    <div class="w-full aspect-[21/9] md:aspect-[2/1] rounded-xl overflow-hidden mb-8 relative group">
      <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent z-10"></div>
      <img alt="<%= @post.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" src="<%= @post.cover_image %>"/>
    </div>

    <!-- Article Header -->
    <header class="mb-10">
      <div class="flex items-center gap-4 mb-6">
        <span class="font-label-mono text-label-mono text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20 uppercase tracking-wider"><%= @post.category %></span>
        <span class="font-label-mono text-label-mono text-on-surface-variant flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">schedule</span> <%= @post.reading_time %> lectura
        </span>
      </div>
      <h1 class="text-3xl md:text-[44px] md:leading-tight font-extrabold text-on-surface mb-6 text-balance bg-gradient-to-r from-primary via-gold-mystic to-primary bg-clip-text text-transparent"><%= @post.title %></h1>
      <div class="flex items-center justify-between border-y border-white/5 py-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-surface-container overflow-hidden">
            <img alt="Author" class="w-full h-full object-cover" src="https://ui-avatars.com/api/?name=<%= u(@post.author.gsub('Por ', '')) %>&background=7C3AED&color=fff"/>
          </div>
          <div>
            <p class="font-body-md text-body-md font-medium text-on-surface"><%= @post.author %></p>
            <p class="font-label-mono text-label-mono text-on-surface-variant"><%= l(@post.published_at, format: :long) %></p>
          </div>
        </div>
        <div class="flex gap-2">
          <button class="w-10 h-10 rounded-full bg-surface-container-low flex items-center justify-center border border-white/5 hover:border-white/20 hover:bg-surface-container transition-all text-on-surface-variant hover:text-primary">
            <span class="material-symbols-outlined">bookmark</span>
          </button>
          <button class="w-10 h-10 rounded-full bg-surface-container-low flex items-center justify-center border border-white/5 hover:border-white/20 hover:bg-surface-container transition-all text-on-surface-variant hover:text-primary">
            <span class="material-symbols-outlined">share</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Article Body -->
    <div class="prose prose-invert max-w-none px-4 md:px-0">
      <% @post.content.split("\n\n").each do |paragraph| %>
        <% if paragraph.start_with?('"') && paragraph.end_with?('"') %>
          <blockquote class="border-l-4 border-primary pl-6 py-2 my-8 bg-surface-container-lowest/30 italic">
            <p class="font-headline-sm text-headline-sm text-on-surface/90 leading-relaxed m-0"><%= paragraph %></p>
          </blockquote>
        <% elsif paragraph.match?(/^(Los |Compuestos|Mientras|Cada|El Viaje|0\.)/) %>
          <h2 class="font-headline-md text-headline-md text-on-surface mt-12 mb-6"><%= paragraph %></h2>
        <% else %>
          <p class="font-body-lg text-body-lg text-on-surface-variant mb-6 leading-relaxed"><%= paragraph %></p>
        <% end %>
      <% end %>
    </div>
  </article>

  <!-- Right Sidebar -->
  <aside class="lg:col-span-4 space-y-8 mt-12 lg:mt-0">
    <!-- Lectura Recomendada -->
    <div class="bg-gradient-to-br from-surface-container-low/90 to-surface-container/60 backdrop-blur-xl border border-white/5 rounded-xl p-6 relative overflow-hidden group">
      <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none"></div>
      <div class="flex items-center gap-2 mb-6">
        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
        <h3 class="font-headline-sm text-headline-sm text-on-surface">Lectura recomendada</h3>
      </div>
      <div class="rounded-lg overflow-hidden mb-4 relative h-40">
        <div class="w-full h-full bg-surface-container-highest flex items-center justify-center">
          <span class="material-symbols-outlined text-5xl text-primary/40">auto_stories</span>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-background/90 to-transparent flex items-end p-4">
          <span class="font-label-mono text-label-mono text-gold-mystic bg-surface-container-highest/80 backdrop-blur px-2 py-1 rounded">TUTORIAL</span>
        </div>
      </div>
      <h4 class="font-body-lg text-body-lg font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors">Dominando la Tirada de la Cruz Celta</h4>
      <p class="font-body-sm text-body-sm text-on-surface-variant mb-6 line-clamp-2">Aprende paso a paso cómo interpretar una de las disposiciones más profundas y reveladoras del Tarot clásico.</p>
      <button class="w-full py-3 rounded-lg bg-surface-container border border-white/10 text-on-surface font-body-md text-body-md font-medium hover:bg-white/5 hover:border-white/20 transition-all flex justify-center items-center gap-2">Leer Artículo <span class="material-symbols-outlined text-[20px]">arrow_forward</span></button>
    </div>

    <!-- Artículos Relacionados -->
    <% if @related_posts.any? %>
      <div>
        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-4 pb-2 border-b border-white/5">Artículos Relacionados</h3>
        <div class="space-y-4">
          <% @related_posts.each do |rp| %>
            <a class="flex gap-4 p-3 rounded-lg hover:bg-surface-container-low/50 transition-colors group" href="<%= blog_post_path(rp) %>">
              <div class="w-20 h-20 rounded-md overflow-hidden flex-shrink-0 bg-surface-container-highest">
                <img alt="<%= rp.title %>" class="w-full h-full object-cover" src="<%= rp.cover_image %>"/>
              </div>
              <div class="flex flex-col justify-center">
                <span class="font-label-mono text-label-mono text-primary mb-1 uppercase"><%= rp.category %></span>
                <h4 class="font-body-md text-body-md text-on-surface font-medium line-clamp-2 group-hover:text-primary transition-colors"><%= rp.title %></h4>
              </div>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  </aside>
</div>