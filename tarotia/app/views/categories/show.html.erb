<div class="space-y-gutter pb-12">
  <nav class="mb-8">
    <a href="<%= categories_path %>" class="text-primary hover:text-primary-fixed flex items-center gap-2 transition-colors font-body-md text-body-md">
      <span class="material-symbols-outlined text-[20px]">arrow_back</span>
      Volver a Categorías
    </a>
  </nav>

  <header class="mb-12">
    <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface font-bold mb-4"><%= @category.name %></h1>
    <div class="h-1 w-20 bg-primary-container rounded-full"></div>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @subcategories.each do |sub| %>
      <div class="glass-card rounded-xl p-6 group cursor-pointer transition-all"
           onclick="window.location='<%= subcategory_path(@category.slug, sub.slug) %>'">
        <div class="flex items-center justify-between">
          <span class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors"><%= sub.name %></span>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors">arrow_forward</span>
        </div>
      </div>
    <% end %>
  </div>
</div>