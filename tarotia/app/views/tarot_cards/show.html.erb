<div class="relative min-h-screen">
  <!-- Background Blobs -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
    <div class="absolute -top-[20%] -left-[10%] w-[60%] h-[60%] bg-mystic-violet-950/30 rounded-full blur-[120px]"></div>
    <div class="absolute top-[40%] -right-[10%] w-[50%] h-[50%] bg-indigo-night-800/20 rounded-full blur-[120px]"></div>
    <div class="absolute -bottom-[10%] left-[20%] w-[40%] h-[40%] bg-primary-container/10 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 md:px-8 py-6 md:py-8">
    <!-- Back Action -->
    <div class="mb-8">
      <a href="<%= root_path %>" class="inline-flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors group">
        <span class="material-symbols-outlined text-lg">arrow_back</span>
        <span class="text-xs uppercase tracking-widest font-bold">Volver al inicio</span>
      </a>
    </div>

    <!-- Detail Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-2 items-start">
      <!-- Left: Card Illustration -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="relative group aspect-[2/3.5] rounded-2xl overflow-hidden glass-card shadow-2xl transition-transform duration-500 hover:scale-[1.01]">
          <img class="w-full h-full object-cover" src="<%= @card[:image] %>" alt="<%= @card[:name] %>" />
          <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent opacity-60"></div>
          <div class="absolute bottom-8 left-0 w-full text-center px-6">
            <span class="text-xs text-primary mb-2 block tracking-widest uppercase font-bold"><%= @card[:arcana] %></span>
            <h2 class="text-4xl md:text-5xl font-bold text-on-surface"><%= @card[:name] %></h2>
          </div>
        </div>
        <!-- Keywords / Chips -->
        <div class="flex flex-wrap gap-2 justify-center">
          <% @card[:keywords].each do |kw| %>
            <span class="px-4 py-2 rounded-full glass-card <%= kw[:color] %> text-xs flex items-center gap-2 font-bold">
              <span class="material-symbols-outlined text-sm"><%= kw[:icon] %></span> <%= kw[:label] %>
            </span>
          <% end %>
        </div>
      </div>

      <!-- Right: Detailed Content -->
      <div class="lg:col-span-7 space-y-8">
        <!-- Introduction -->
        <section class="glass-card p-6 md:p-8 rounded-2xl">
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-primary text-3xl">auto_awesome</span>
            <h3 class="text-xl md:text-2xl font-bold text-on-surface">Significado General</h3>
          </div>
          <p class="text-on-surface-variant text-base md:text-lg leading-relaxed">
            <%= @card[:general] %>
          </p>
        </section>

        <!-- Bento Detail Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="glass-card p-6 rounded-2xl border-l-4 border-rose-passion/50">
            <div class="flex items-center gap-3 mb-4">
              <span class="material-symbols-outlined text-rose-passion">favorite</span>
              <h4 class="font-bold text-on-surface">Amor y Relaciones</h4>
            </div>
            <p class="text-sm text-on-surface-variant leading-relaxed">
              <%= @card[:amor] %>
            </p>
          </div>
          <div class="glass-card p-6 rounded-2xl border-l-4 border-gold-mystic/50">
            <div class="flex items-center gap-3 mb-4">
              <span class="material-symbols-outlined text-gold-mystic">payments</span>
              <h4 class="font-bold text-on-surface">Trabajo y Dinero</h4>
            </div>
            <p class="text-sm text-on-surface-variant leading-relaxed">
              <%= @card[:trabajo] %>
            </p>
          </div>
        </div>

        <!-- Simbología Section -->
        <section class="glass-card p-6 md:p-8 rounded-2xl">
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-cyan-ethereal text-3xl">token</span>
            <h3 class="text-xl md:text-2xl font-bold text-on-surface">Simbología</h3>
          </div>
          <div class="space-y-6">
            <% @card[:simbolismo].each do |sim| %>
              <div class="flex gap-4 items-start">
                <div class="w-10 h-10 rounded-lg bg-surface-variant flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-primary"><%= sim[:icon] %></span>
                </div>
                <div>
                  <p class="font-bold text-on-surface mb-1"><%= sim[:title] %></p>
                  <p class="text-sm text-on-surface-variant leading-relaxed"><%= sim[:desc] %></p>
                </div>
              </div>
            <% end %>
          </div>
        </section>

        <!-- Call to Action -->
        <div class="flex gap-4 items-center justify-end py-8">
          <button class="px-6 py-3 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-variant transition-colors font-bold text-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">share</span> Compartir
          </button>
          <button class="px-8 py-3 rounded-lg bg-primary-container text-on-primary-container hover:scale-105 transition-transform font-bold text-sm flex items-center gap-2 shadow-lg shadow-primary-container/30">
            <span class="material-symbols-outlined text-lg">auto_fix</span> Tirada Especial
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
