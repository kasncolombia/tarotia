  <nav class="space-y-1 mb-8">
    <a href="<%= blog_path %>" class="flex items-center gap-3 px-4 py-2.5 <%= current_page?(blog_path) ? 'bg-white/10 text-on-surface' : 'text-on-surface-variant hover:bg-white/5' %> rounded-lg transition-all group">
      <span class="material-symbols-outlined text-[20px]">article</span>
      <span>Blog & Guías</span>
    </a>
    <a href="<%= categories_path %>" class="flex items-center gap-3 px-4 py-2.5 <%= current_page?(categories_path) ? 'bg-white/10 text-on-surface' : 'text-on-surface-variant hover:bg-white/5' %> rounded-lg transition-all group">
