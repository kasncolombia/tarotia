<aside class="w-[280px] bg-surface border-r border-white/5 flex flex-col p-6 overflow-y-auto shrink-0 custom-scrollbar hidden md:flex">
  <!-- Logo -->
  <div class="mb-10 px-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-primary-container rounded-xl flex items-center justify-center shadow-lg shadow-primary-container/20">
