    </a>
    <a href="#" class="flex items-center justify-between px-4 py-3 text-on-surface-variant hover:bg-white/5 rounded-lg transition-all group">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px]">flare</span>
        <span>Tirada Diaria</span>
      </div>
      <span class="bg-primary-container text-[10px] px-2 py-0.5 rounded font-bold text-on-primary-container uppercase tracking-tighter">Nuevo</span>
