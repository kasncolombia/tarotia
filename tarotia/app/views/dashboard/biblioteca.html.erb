<div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
  <div class="absolute -top-[20%] -left-[10%] w-[60%] h-[60%] bg-mystic-violet-950/30 rounded-full blur-[120px]"></div>
  <div class="absolute top-[40%] -right-[10%] w-[50%] h-[50%] bg-indigo-night-800/20 rounded-full blur-[120px]"></div>
  <div class="absolute -bottom-[10%] left-[20%] w-[40%] h-[40%] bg-primary-container/10 rounded-full blur-[120px]"></div>
</div>

<div class="max-w-6xl mx-auto px-4 md:px-8 py-6 md:py-8">
  <!-- Header -->
  <div class="mb-8">
    <a href="<%= root_path %>" class="inline-flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors mb-6 group">
      <span class="material-symbols-outlined text-lg">arrow_back</span>
      <span class="text-xs uppercase tracking-widest font-bold">Volver al inicio</span>
    </a>
    <h2 class="text-4xl md:text-5xl font-bold text-on-surface mb-2">Biblioteca del Destino</h2>
    <p class="text-on-surface-variant">Explora el significado de cada arcano mayor y menor del tarot.</p>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap gap-2 mb-8">
    <button class="px-6 py-2 rounded-full bg-primary text-on-primary font-semibold text-sm">Todos</button>
    <button class="px-6 py-2 rounded-full bg-surface-variant/40 hover:bg-surface-variant/60 border border-white/5 text-sm transition-all">Arcanos Mayores</button>
    <button class="px-6 py-2 rounded-full bg-surface-variant/40 hover:bg-surface-variant/60 border border-white/5 text-sm transition-all">Arcanos Menores</button>
    <button class="px-6 py-2 rounded-full bg-surface-variant/40 hover:bg-surface-variant/60 border border-white/5 text-sm transition-all">Bastos</button>
    <button class="px-6 py-2 rounded-full bg-surface-variant/40 hover:bg-surface-variant/60 border border-white/5 text-sm transition-all">Copas</button>
    <button class="px-6 py-2 rounded-full bg-surface-variant/40 hover:bg-surface-variant/60 border border-white/5 text-sm transition-all">Espadas</button>
    <button class="px-6 py-2 rounded-full bg-surface-variant/40 hover:bg-surface-variant/60 border border-white/5 text-sm transition-all">Oros</button>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6">
    <% [
      { name: 'El Loco', img: '/emperatriz-tarot.png' },
      { name: 'El Mago', img: '/emperatriz-tarot.png' },
      { name: 'La Sacerdotisa', img: '/emperatriz-tarot.png' },
      { name: 'La Emperatriz', img: '/emperatriz-tarot.png', slug: 'la-emperatriz' },
      { name: 'El Emperador', img: '/emperatriz-tarot.png' },
      { name: 'El Hierofante', img: '/emperatriz-tarot.png' },
      { name: 'Los Enamorados', img: '/los-enamordos.png', slug: 'los-enamorados' },
      { name: 'El Carro', img: '/el-mundo.png' },
      { name: 'La Justicia', img: '/el-mundo.png' },
      { name: 'El Ermitaño', img: '/el-mundo.png' },
      { name: 'La Rueda', img: '/el-mundo.png' },
      { name: 'La Fuerza', img: '/el-mundo.png' },
      { name: 'El Colgado', img: '/el-mundo.png' },
      { name: 'La Muerte', img: '/el-mundo.png' },
      { name: 'La Templanza', img: '/el-mundo.png' },
      { name: 'El Diablo', img: '/el-mundo.png' },
      { name: 'La Torre', img: '/el-mundo.png' },
      { name: 'La Estrella', img: '/el-mundo.png' }
    ].each do |card| %>
      <a href="<%= card[:slug] ? tarot_card_path(card[:slug]) : '#' %>" class="glass-card rounded-2xl overflow-hidden group cursor-pointer hover:scale-[1.02] transition-all duration-300">
        <div class="relative aspect-[2/3]">
          <img src="<%= card[:img] %>" alt="<%= card[:name] %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <h3 class="font-bold text-white"><%= card[:name] %></h3>
          </div>
        </div>
      </a>
    <% end %>
  </div>
</div>
