<div class="min-h-screen flex flex-col">
  <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-container/20 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[30rem] h-[30rem] bg-indigo-night-800/20 rounded-full blur-[120px]"></div>
  </div>

  <%= render partial: 'shared/auth_header', locals: { active: 'login' } %>

  <div class="relative z-10 flex-1 flex items-center justify-center px-4 py-12 md:py-16">
    <div class="w-full max-w-md">
      <div class="bg-gradient-to-br from-surface-container/80 to-surface-container-low/90 backdrop-blur-[16px] border border-white/5 rounded-2xl overflow-hidden shadow-2xl">
        <div class="p-8 md:p-10">
          <div class="text-center flex flex-col items-center gap-2 mb-8">
            <span class="material-symbols-outlined text-4xl text-primary" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
            <h1 class="text-2xl font-bold text-on-surface tracking-wide">Iniciar Sesión</h1>
            <p class="text-sm text-on-surface-variant">Accede a tu destino, revelado</p>
          </div>

          <% if flash[:alert] %>
            <div class="bg-rose-passion/10 border border-rose-passion/30 rounded-lg p-3 mb-4 text-sm text-rose-passion text-center">
              <%= flash[:alert] %>
            </div>
          <% end %>

          <%= form_tag login_path, class: 'flex flex-col gap-6', data: { turbo: false } do %>
            <div class="flex flex-col gap-4">
              <div class="flex flex-col gap-2">
                <label class="text-xs font-bold text-on-surface-variant uppercase" for="email">Correo Electrónico</label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant">mail</span>
                  <input class="w-full bg-surface-container/70 backdrop-blur-md border border-white/5 rounded-lg py-3 pl-10 pr-4 text-sm text-on-surface placeholder:text-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all" id="email" name="email" placeholder="tu@correo.com" required="" type="email"/>
                </div>
              </div>
              <div class="flex flex-col gap-2">
                <div class="flex justify-between items-center">
                  <label class="text-xs font-bold text-on-surface-variant uppercase" for="password">Contraseña</label>
                  <a class="text-xs text-primary hover:text-primary-fixed transition-colors" href="#">¿Olvidé mi contraseña?</a>
                </div>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant">lock</span>
                  <input class="w-full bg-surface-container/70 backdrop-blur-md border border-white/5 rounded-lg py-3 pl-10 pr-4 text-sm text-on-surface placeholder:text-outline-variant focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all" id="password" name="password" placeholder="••••••••" required="" type="password"/>
                </div>
              </div>
            </div>

            <button class="w-full bg-primary-container text-white text-sm font-semibold py-3 rounded-lg hover:bg-primary-container/90 hover:shadow-[0_0_15px_rgba(124,58,237,0.4)] transition-all flex items-center justify-center gap-2 cursor-pointer" type="submit">
              <span>Entrar</span>
              <span class="material-symbols-outlined text-sm">login</span>
            </button>
          <% end %>

          <div class="flex items-center gap-4 my-7">
            <div class="flex-1 h-px bg-white/5"></div>
            <span class="text-xs font-bold text-outline-variant uppercase">O INGRESA CON</span>
            <div class="flex-1 h-px bg-white/5"></div>
          </div>

          <div class="flex flex-col gap-3">
            <button class="w-full bg-transparent border border-white/10 text-sm text-on-surface py-2.5 rounded-lg hover:border-white/20 hover:bg-white/5 transition-all flex items-center justify-center gap-3 cursor-pointer" type="button">
              <svg class="w-5 h-5" fill="currentColor" viewbox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
              Google
            </button>
            <button class="w-full bg-transparent border border-white/10 text-sm text-on-surface py-2.5 rounded-lg hover:border-white/20 hover:bg-white/5 transition-all flex items-center justify-center gap-3 cursor-pointer" type="button">
              <svg class="w-5 h-5" fill="currentColor" viewbox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12c0-5.523-4.477-10-10-10z"/></svg>
              Apple
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>

  <%= render partial: 'shared/auth_footer' %>
</div>