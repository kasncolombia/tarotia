<!-- Atmospheric Background Effects -->
<div class="fixed inset-0 pointer-events-none z-0">
  <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-primary-container/20 blur-[120px]"></div>
  <div class="absolute bottom-[-20%] right-[-10%] w-[60%] h-[60%] rounded-full bg-indigo-night-800/20 blur-[150px]"></div>
</div>

<div class="relative w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop min-h-screen flex items-center justify-center z-10 py-12">
  <div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-0 rounded-2xl overflow-hidden border border-white/5 shadow-2xl bg-surface/40 backdrop-blur-[16px] max-w-5xl">
    <!-- Left Side: Visual & Benefits -->
    <div class="relative hidden lg:flex flex-col justify-between p-12 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img alt="Cosmic Background" class="w-full h-full object-cover opacity-40 mix-blend-luminosity" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA6Rdxj4lZWRbUuwQ7y74soOUxSBAUffG_t4eUNHTRY68FOb2MQnvrI8ANxzebPhAV1DwCl_Y-zINGE4LHWwz2X8tE_2sp2YKLsfLP5lAb03tXqvSl4JZVtHyDl4mxS52O_y4zpf4DKo8papfLmB4m1mcqPHYFUeotK9vrY0L1CXGD3Ue03W_LIjv31k9NzpJsqRfmkn8frWHX4jlKtzKGP4WkNOaNFlI4J9FQhvexf0G6R431RcH0egkBhktGa-AkEL6-9ec76sIka"/>
        <div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-background/50 to-background"></div>
      </div>
      <div class="relative z-10">
        <h1 class="font-headline-sm text-headline-sm font-bold tracking-widest text-primary mb-2 uppercase">TAROT IA</h1>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Inteligencia Artificial Divinatoria</p>
      </div>
      <div class="relative z-10 mt-16 flex-grow flex flex-col justify-center">
        <h2 class="font-display-lg text-display-lg text-on-background mb-8 leading-tight">Despierta tu<br/><span class="text-primary">intuición digital</span>.</h2>
        <ul class="space-y-6">
          <li class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center border border-white/10 shrink-0">
              <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">auto_stories</span>
            </div>
            <div>
              <h3 class="font-body-md text-body-md font-semibold text-on-background mb-1">Guarda tus lecturas</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Lleva un registro histórico de todas tus consultas y analiza tus patrones a lo largo del tiempo.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center border border-white/10 shrink-0">
              <span class="material-symbols-outlined text-emerald-abundance" style="font-variation-settings: 'FILL' 1;">trending_up</span>
            </div>
            <div>
              <h3 class="font-body-md text-body-md font-semibold text-on-background mb-1">Sigue tu energía diaria</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Recibe insights personalizados basados en la alineación astrológica y tus lecturas recientes.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center border border-white/10 shrink-0">
              <span class="material-symbols-outlined text-gold-mystic-400" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
            </div>
            <div>
              <h3 class="font-body-md text-body-md font-semibold text-on-background mb-1">Acceso a tiradas avanzadas</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Desbloquea disposiciones complejas como la Cruz Celta y el Árbol de la Vida.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Right Side: Registration Form -->
    <div class="p-8 md:p-12 lg:p-16 flex flex-col justify-center bg-surface-container/30 relative">
      <div class="lg:hidden mb-8 text-center">
        <h1 class="font-headline-sm text-headline-sm font-bold tracking-widest text-primary uppercase">TAROT IA</h1>
      </div>
      <div class="mb-10 text-center lg:text-left">
        <h2 class="font-headline-md text-headline-md text-on-background mb-3">Comenzar mi viaje</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">Únete a nosotros para descifrar los mensajes del universo.</p>
      </div>

      <%= form_tag '#', class: 'space-y-6' do %>
        <!-- Name Input -->
        <div class="space-y-2">
          <label class="block font-label-mono text-label-mono text-on-surface-variant uppercase tracking-wider" for="name">Nombre Completo</label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">person</span>
            <input class="w-full bg-surface-container-low/70 border border-outline-variant rounded-lg py-3 pl-12 pr-4 text-on-background placeholder:text-outline-variant focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all outline-none font-body-md text-body-md" id="name" name="name" placeholder="Tu nombre" type="text"/>
          </div>
        </div>
        <!-- Email Input -->
        <div class="space-y-2">
          <label class="block font-label-mono text-label-mono text-on-surface-variant uppercase tracking-wider" for="email">Correo Electrónico</label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">mail</span>
            <input class="w-full bg-surface-container-low/70 border border-outline-variant rounded-lg py-3 pl-12 pr-4 text-on-background placeholder:text-outline-variant focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all outline-none font-body-md text-body-md" id="email" name="email" placeholder="tu@correo.com" type="email"/>
          </div>
        </div>
        <!-- Password Input -->
        <div class="space-y-2">
          <label class="block font-label-mono text-label-mono text-on-surface-variant uppercase tracking-wider" for="password">Contraseña</label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">lock</span>
            <input class="w-full bg-surface-container-low/70 border border-outline-variant rounded-lg py-3 pl-12 pr-4 text-on-background placeholder:text-outline-variant focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all outline-none font-body-md text-body-md" id="password" name="password" placeholder="••••••••" type="password"/>
            <button class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors" type="button">
              <span class="material-symbols-outlined">visibility</span>
            </button>
          </div>
          <p class="font-body-sm text-body-sm text-outline mt-2">Debe tener al menos 8 caracteres.</p>
        </div>
        <!-- Submit Button -->
        <button class="w-full bg-primary-container hover:bg-primary-container/90 text-on-primary-container font-body-md text-body-md font-semibold py-4 rounded-lg transition-colors flex justify-center items-center gap-2 mt-8" type="submit">
          <span>Comenzar mi viaje</span>
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </button>
      <% end %>

      <div class="mt-8 text-center">
        <p class="font-body-sm text-body-sm text-on-surface-variant">
          ¿Ya tienes una cuenta? 
          <a class="text-primary hover:text-primary-fixed-dim font-medium transition-colors" href="<%= login_path %>">Inicia sesión</a>
        </p>
      </div>

      <div class="absolute top-4 right-4 text-outline-variant/30 pointer-events-none">
        <span class="material-symbols-outlined text-4xl">flare</span>
      </div>
      <div class="absolute bottom-4 left-4 text-outline-variant/30 pointer-events-none">
        <span class="material-symbols-outlined text-4xl">bedtime</span>
      </div>
    </div>
  </div>
</div>